{# Outlook renders with the Word engine: tables for layout, inline styles only.

   Same width, same spacing and the same three colours as the urgency report: a
   client who gets both should not feel they came from two different companies.
   The width declared as an HTML attribute is what stops each block from
   collapsing to its own content width. #}
{% set rule = '#d9d9db' %}
{% set soft = '#6b6b6d' %}
{% set width = 660 %}
<div style="font-family: Calibri, Arial, sans-serif; font-size: 11pt; line-height: 1.5; color: #202020;">
  <p style="margin: 0 0 14px 0;">{{ greeting }} {{ client_name }},</p>

  <p style="margin: 0 0 20px 0;">
    Junto con saludar, adjuntamos el resumen de las alarmas registradas por el
    sistema de monitoreo en sus equipos durante el período
    <strong>{{ period }}</strong>.
  </p>

  <table cellpadding="0" cellspacing="0" border="0" width="{{ width }}"
         style="border-collapse: collapse; width: {{ width }}px; max-width: 100%; margin: 0 0 24px 0;">
    <tr>
      <td style="background-color: {{ brand }}; color: #ffffff; padding: 12px 16px;
                 font-size: 11pt; font-weight: bold;">
        {{ total_events }} alarma{{ 's' if total_events > 1 else '' }} en
        {{ summaries|length }} equipo{{ 's' if summaries|length > 1 else '' }}
      </td>
    </tr>
  </table>

{% if repeated %}
  <p style="margin: 0 0 10px 0;">
    <strong>Equipos con alarmas reiteradas.</strong> La repetición sugiere una
    condición persistente, y recomendamos priorizar su revisión.
  </p>

  <table cellpadding="0" cellspacing="0" border="0" width="{{ width }}"
         style="border-collapse: collapse; width: {{ width }}px; max-width: 100%; margin: 0 0 24px 0;">
    <tr>
      <td style="background-color: #a85400; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">EQUIPO</td>
      <td width="70" style="background-color: #a85400; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;
                 text-align: center; width: 70px;">ALARMAS</td>
      <td style="background-color: #a85400; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">CONDICIÓN DETECTADA</td>
      <td style="background-color: #a85400; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">PLAZO</td>
    </tr>
{% for row in repeated %}
    <tr>
      <td style="border: 1px solid {{ rule }}; border-top: none; padding: 11px 14px;
                 font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.label }}<br>
        <span style="color: {{ soft }};">{{ row.plant }}</span>
      </td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 13pt; font-weight: bold;
                 text-align: center; vertical-align: top;">{{ row.count }}</td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.status }}<br>
        <span style="color: {{ soft }};">{{ row.types }}</span>
      </td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.urgency }}
      </td>
    </tr>
{% endfor %}
  </table>
{% endif %}

{% if single %}
  <p style="margin: 0 0 10px 0;">
    <strong>Equipos con una alarma en el período.</strong>
  </p>

  <table cellpadding="0" cellspacing="0" border="0" width="{{ width }}"
         style="border-collapse: collapse; width: {{ width }}px; max-width: 100%; margin: 0 0 24px 0;">
    <tr>
      <td style="background-color: #7a7a7c; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">EQUIPO</td>
      <td width="120" style="background-color: #7a7a7c; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px; width: 120px;">FECHA</td>
      <td style="background-color: #7a7a7c; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">CONDICIÓN DETECTADA</td>
      <td style="background-color: #7a7a7c; color: #ffffff; padding: 9px 14px;
                 font-size: 8.5pt; font-weight: bold; letter-spacing: 0.5px;">PLAZO</td>
    </tr>
{% for row in single %}
    <tr>
      <td style="border: 1px solid {{ rule }}; border-top: none; padding: 11px 14px;
                 font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.label }}<br>
        <span style="color: {{ soft }};">{{ row.plant }}</span>
      </td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 9.5pt; white-space: nowrap;
                 vertical-align: top;">{{ row.date }}</td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.status }}
      </td>
      <td style="border: 1px solid {{ rule }}; border-top: none; border-left: none;
                 padding: 11px 14px; font-size: 9.5pt; line-height: 1.5; vertical-align: top;">
        {{ row.urgency }}
      </td>
    </tr>
{% endfor %}
  </table>
{% endif %}

{% if emeltec_note %}
  <table cellpadding="0" cellspacing="0" border="0" width="{{ width }}"
         style="border-collapse: collapse; width: {{ width }}px; max-width: 100%; margin: 0 0 22px 0;">
    <tr>
      <td style="background-color: #4a4a4c; color: #ffffff; padding: 10px 16px;
                 font-size: 9.5pt; font-weight: bold; letter-spacing: 1px;">
        OBSERVACIONES DE EMELTEC
      </td>
    </tr>
    <tr>
      <td style="border: 1px solid {{ rule }}; border-top: none; padding: 16px;
                 font-size: 10pt; line-height: 1.6;">
        [COMPLETAR]
      </td>
    </tr>
  </table>
{% endif %}

  <p style="margin: 0 0 14px 0;">Quedamos atentos a sus comentarios.</p>

  <p style="margin: 0;">Saludos cordiales,</p>
</div>
